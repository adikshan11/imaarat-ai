{
  "mcpServers": {
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.83",
        "--isolated",
        "--headless"
      ]
    },
    "langfuse": {
      "type": "http",
      "url": "https://cloud.langfuse.com/api/public/mcp",
      "headers": {
        "Authorization": "${LANGFUSE_MCP_AUTHORIZATION:-}"
      }
    }
  }
}
